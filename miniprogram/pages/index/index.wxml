<view class="page">
  <view class="card hero">
    <view class="title">WeKnora 知识库</view>
    <view class="muted">选择知识库，将网页导入其中。</view>
  </view>

  <view class="card section">
    <view wx:if="{{needsSettings}}" class="notice">
      请先配置 WeKnora 后端地址和 API 密钥，再加载知识库。
      <button bindtap="openSettings" class="secondary">前往设置</button>
    </view>

    <view class="field">
      <text class="label">知识库</text>
      <picker range="{{knowledgeBaseNames}}" value="{{selectedIndex}}" bindchange="onKnowledgeBaseChange">
        <view class="picker-value">{{selectedKnowledgeBaseName || "点击选择知识库"}}</view>
      </picker>
      <view wx:if="{{statusMessage}}" class="status-message">{{statusMessage}}</view>
      <view wx:if="{{knowledgeBaseNames.length}}" class="knowledge-list">
        <view
          wx:for="{{knowledgeBaseNames}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onKnowledgeBaseTap"
          class="knowledge-item {{index == selectedIndex ? 'active' : ''}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <button bindtap="loadKnowledgeBases" loading="{{loading}}">刷新知识库</button>
  </view>

  <view class="card section">
    <view class="field">
      <text class="label">网页地址</text>
      <input value="{{url}}" placeholder="请输入需要导入的网页地址" bindinput="onUrlInput" />
    </view>

    <button bindtap="importURL" loading="{{importing}}" disabled="{{!selectedKnowledgeBaseId || !url}}">导入网页</button>
  </view>
</view>
