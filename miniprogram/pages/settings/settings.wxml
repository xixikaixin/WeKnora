<view class="page">
  <view class="card">
    <view class="title">连接 WeKnora</view>
    <view class="muted">填写已部署的后端地址和工作区 API 密钥。</view>

    <view class="field">
      <text class="label">后端地址</text>
      <input value="{{baseUrl}}" placeholder="https://your-weknora.example.com" bindinput="onBaseUrlInput" />
    </view>

    <view class="field">
      <text class="label">API 密钥</text>
      <input value="{{apiKey}}" password placeholder="sk-..." bindinput="onApiKeyInput" />
    </view>

    <button bindtap="save">保存设置</button>
  </view>
</view>
