<view class="page">
  <view class="card">
    <view class="title">知识库问答</view>
    <view class="muted">向所选 WeKnora 知识库提问。</view>

    <view class="field">
      <text class="label">问题</text>
      <textarea value="{{query}}" placeholder="请输入你的问题…" bindinput="onQueryInput" />
    </view>

    <button bindtap="ask" loading="{{loading}}" disabled="{{!query}}">发送问题</button>
  </view>

  <view class="card answer-card" wx:if="{{answer || rawResponse}}">
    <view class="label">回答</view>
    <view class="answer">{{answer || '未生成正式回答，请重试。'}}</view>
  </view>
</view>
